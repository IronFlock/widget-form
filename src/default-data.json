{
    "title": "Example Input Form",
    "subTitle": "Please provide machine details",
    "formButton": false,
    "fieldLayout": {
        "density": "compact"
    },
    "formFields": [
        {
            "label": "Machine Type",
            "type": "dropdown",
            "width": "half",
            "description": "Select machine type from list",
            "defaultValue": "pump",
            "values": [
                {
                    "displayLabel": "Pump",
                    "value": "pump"
                },
                {
                    "displayLabel": "Compressor",
                    "value": "compressor"
                },
                {
                    "displayLabel": "Generator",
                    "value": "generator"
                }
            ]
        },
        {
            "label": "Machine Name",
            "type": "textfield",
            "width": "half",
            "description": "Enter the name of the machine",
            "validation": "^[a-zA-Z0-9 ]{3,50}$",
            "defaultValue": "Pump A1",
            "required": true
        },
        {
            "label": "Operating Temperature",
            "type": "numberfield",
            "width": "half",
            "min": 0,
            "max": 100,
            "description": "Current operating temperature",
            "defaultValue": "68.5",
            "conditionalDisplay": {
                "conditionField": "Machine Type",
                "conditionValues": "compressor, generator"
            }
        },
        {
            "label": "Active",
            "type": "checkbox",
            "width": "half",
            "description": "Check if the machine is active",
            "defaultValueBoolean": true
        },
        {
            "label": "Maintenance",
            "type": "section",
            "groupWidth": "half",
            "description": "Notes and the last service"
        },
        {
            "label": "Description",
            "type": "textarea",
            "width": "full",
            "description": "Provide additional notes or comments",
            "defaultValueMultiline": "No issues reported."
        },
        {
            "label": "Last Maintenance",
            "type": "datetime",
            "description": "Date and time of the last maintenance",
            "defaultValue": "2025-07-07T08:30:00Z"
        }
    ]
}
