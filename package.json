{
    "name": "@ironflock/widget-form",
    "description": "REWidget widget-form",
    "license": "MIT",
    "author": "widget-form",
    "version": "1.0.46",
    "engines": {
        "node": ">=24.9.0",
        "npm": ">=10.0.2"
    },
    "type": "module",
    "main": "dist/widget-form.js",
    "module": "dist/widget-form.js",
    "types": "dist/widget-form.d.ts",
    "files": [
        "dist",
        "src",
        "thumbnail.png",
        "thumbnail.webp"
    ],
    "scripts": {
        "start": "vite build --watch & vite",
        "build": "vite build",
        "watch": "vite build --watch",
        "link": "npm run build && npm link && cd ../RESWARM/frontend && npm link @ironflock/widget-form",
        "unlink": "npm unlink --global && cd ../RESWARM/frontend && npm unlink @ironflock/widget-form && npm i @ironflock/widget-form",
        "types": "cat src/definition-schema.json | json2ts --style.tabWidth=4 > src/definition-schema.d.ts"
    },
    "dependencies": {
        "lit": "^3.3.3",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@material/web": "^2.4.1"
    },
    "devDependencies": {
        "@material/web": "^2.4.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@types/node": "^25.5.0",
        "json-schema-to-typescript": "^15.0.4",
        "typescript": "5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-dts": "^5.1.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IronFlock/widget-form.git"
    },
    "keywords": [
        "widget",
        "table"
    ],
    "bugs": {
        "url": "https://github.com/IronFlock/widget-form/issues"
    },
    "homepage": "https://github.com/IronFlock/widget-form#readme"
}
